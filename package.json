{
  "name": "@fediverse-miniapps/sdk",
  "version": "0.1.0",
  "description": "App-side SDK for origin-pinned Fediverse miniapps",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./host/jaw-sponsored-token": {
      "types": "./host/jaw_sponsored_token_adapter.d.ts",
      "import": "./host/jaw_sponsored_token_adapter.js",
      "default": "./host/jaw_sponsored_token_adapter.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "host/",
    "wallet/",
    "README.md",
    "SERVER_IMPLEMENTERS.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "deno check test/types.ts",
    "check": "npm test && npm run typecheck"
  }
}
